function slugify(s){return String(s||"").toLowerCase().normalize("NFKD").replace(/[\u0900-\u097F]/g,"").replace(/[^a-z0-9]+/g,"-").replace(/^-+|-+$/g,"")||"item";}
function assignSlugs(list){const by=[...list].sort((a,b)=>(a.createdAtMs||0)-(b.createdAtMs||0));const used={};for(const p of by){let base=slugify(p.name),s=base,n=2;while(used[s]){s=base+"-"+n;n++;}used[s]=true;p.slug=s;}return list;}
function dv(v){if(v==null)return null;if(v.stringValue!==undefined)return v.stringValue;if(v.integerValue!==undefined)return Number(v.integerValue);if(v.numberValue!==undefined)return Number(v.numberValue);if(v.booleanValue!==undefined)return v.booleanValue;if(v.timestampValue!==undefined)return v.timestampValue;if(v.arrayValue)return(v.arrayValue.values||[]).map(dv);if(v.mapValue)return df(v.mapValue.fields||{});return null;}
function df(f){const o={};for(const k in f)o[k]=dv(f[k]);return o;}
async function fetchDocs(pid,key,coll){let out=[],token="";do{const u=`https://firestore.googleapis.com/v1/projects/${pid}/databases/(default)/documents/${coll}?pageSize=300${token?"&pageToken="+token:""}&key=${key}`;const r=await fetch(u);const j=await r.json();for(const d of(j.documents||[])){const o=df(d.fields||{});o.id=d.name.split("/").pop();if(o.createdAt)o.createdAtMs=Date.parse(o.createdAt)||0;out.push(o);}token=j.nextPageToken||"";}while(token);return out;}
function lastmod(t){const d=t?new Date(t):new Date();return d.toISOString().slice(0,10);}
export async function onRequestGet(ctx){
  const origin=new URL(ctx.request.url).origin;
  const html=await(await fetch(origin+"/index.html")).text();
  const pid=(html.match(/projectId:\s*"([^"]+)"/)||[])[1];
  const key=(html.match(/apiKey:\s*"([^"]+)"/)||[])[1];
  let urls=[{loc:"/",last:lastmod(),chg:"daily"}];
  try{
    if(pid&&key){
      const cats=(await fetchDocs(pid,key,"categories")).filter(c=>c.isActive);
      const prods=assignSlugs((await fetchDocs(pid,key,"products")).filter(p=>p.isActive));
      for(const c of cats)urls.push({loc:"/category/"+slugify(c.name),last:lastmod(),chg:"weekly"});
      for(const p of prods)urls.push({loc:"/product/"+p.slug,last:lastmod(p.updatedAt||p.createdAt),chg:"weekly"});
    }
  }catch(e){}
  const xml=`<?xml version="1.0" encoding="UTF-8"?>\n<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">\n`+urls.map(u=>`<url><loc>${origin}${u.loc}</loc><lastmod>${u.last}</lastmod><changefreq>${u.chg}</changefreq></url>`).join("\n")+`\n</urlset>`;
  return new Response(xml,{headers:{"content-type":"application/xml","cache-control":"public, max-age=300"}});
}
